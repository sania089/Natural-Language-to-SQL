# Copy to .env and fill in. Never commit .env.

# --- Backend ---
# Free-tier keys. Gemini is primary; Groq is the fallback.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# low | medium | high: lower = faster answers from Gemini's reasoning model
GEMINI_REASONING_EFFORT=low
# Reply cap (includes reasoning tokens); and LRU size for repeated questions (0 = off)
LLM_MAX_TOKENS=1024
ANSWER_CACHE_SIZE=128
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DATABASE_PATH=data/ecommerce.db
MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=5
MAX_QUESTION_LENGTH=500
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
